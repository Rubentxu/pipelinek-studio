#!/usr/bin/env bash
# B6.1 (2026-10-10): asdf-vm plugin — list-all
#
# Lists the installable versions of
# pipelinek-studio by querying the GitHub
# Releases API. The asdf-vm standard
# contract is: print one version per line,
# latest first, only `v*` tags.
#
# The plugin is intentionally tolerant:
# when curl is missing or the GitHub API is
# unreachable, the script exits 0 with no
# output (asdf treats this as "no versions
# available" rather than a hard error).

set -e

REPO="${PIPELINEK_STUDIO_REPO:-Rubentxu/pipelinek-studio}"
GITHUB_API="https://api.github.com/repos/${REPO}/releases?per_page=30"

if ! command -v curl >/dev/null 2>&1; then
    exit 0
fi

curl -sSL \
    -H "Accept: application/vnd.github+json" \
    -H "User-Agent: asdf-pipelinek-studio" \
    "$GITHUB_API" 2>/dev/null \
    | grep -oE '"tag_name":\s*"v[0-9][^"]+"' \
    | sed -E 's/.*"v([^"]+)".*/\1/' \
    | sort -V \
    | tac \
    || true
