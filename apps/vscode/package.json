{
  "name": "pipelinek-studio",
  "displayName": "PipelineK Studio",
  "description": "S5 E5.3 — VS Code client for the PipelineK Studio HTTP control plane. Uses the generated sdk.ts to talk to the local Studio server.",
  "version": "1.0.0-rc.7",
  "private": true,
  "publisher": "pipelinek-studio",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1E5FBE",
    "theme": "dark"
  },
  "activationEvents": [
    "onCommand:pipelinek-studio.health",
    "onCommand:pipelinek-studio.createExperiment",
    "onCommand:pipelinek-studio.listSteps",
    "onStartupFinished",
    "workspaceContains:**/*.pipeline.kts"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pipelinek-studio",
          "title": "PipelineK Studio",
          "icon": "images/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "pipelinek-studio.status",
        "title": "Studio: Show Event Stream Status",
        "category": "PipelineK Studio"
      },
      {
        "command": "pipelinek-studio.health",
        "title": "Studio: Ping Health",
        "category": "PipelineK Studio"
      },
      {
        "command": "pipelinek-studio.createExperiment",
        "title": "Studio: Create Experiment",
        "category": "PipelineK Studio"
      },
      {
        "command": "pipelinek-studio.listSteps",
        "title": "Studio: List Steps",
        "category": "PipelineK Studio"
      },
      {
        "command": "pipelinek-studio.openOpenApi",
        "title": "Studio: Show OpenAPI Document",
        "category": "PipelineK Studio"
      },
      {
        "command": "pipelinek-studio.tree.refresh",
        "title": "Studio: Refresh Tree",
        "category": "PipelineK Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "pipelinek-studio.openRun",
        "title": "Studio: Open Run",
        "category": "PipelineK Studio"
      },
      {
        "command": "pipelinek-studio.cancelRun",
        "title": "Studio: Cancel Run",
        "category": "PipelineK Studio"
      },
      {
        "command": "pipelinek-studio.sealAndRun",
        "title": "Studio: Seal + Run",
        "category": "PipelineK Studio"
      }
    ],
    "views": {
      "pipelinek-studio": [
        {
          "id": "pipelinek-studio.tree",
          "name": "Experiments",
          "when": "true"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "pipelinek-studio.tree.refresh",
          "when": "view == pipelinek-studio.tree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pipelinek-studio.openRun",
          "when": "view == pipelinek-studio.tree && viewItem == run",
          "group": "inline"
        },
        {
          "command": "pipelinek-studio.cancelRun",
          "when": "view == pipelinek-studio.tree && viewItem == run",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "PipelineK Studio",
      "properties": {
        "pipelinekStudio.baseUrl": {
          "type": "string",
          "default": "https://127.0.0.1:7778",
          "description": "Base URL of the local PipelineK Studio server. Defaults to HTTPS on 7778 to match the studio's C-1 default; set to an http:// URL only if the studio was started with --insecure-http."
        },
        "pipelinekStudio.profile": {
          "type": "string",
          "default": "default",
          "description": "Profile name sent as X-Studio-Profile on every request. Use to disambiguate multiple local Studio instances (one per worktree, for example). The default is 'default'."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "eslint": "^9.39.5",
    "typescript": "^5.6.2",
    "vitest": "^2.1.5"
  }
}
